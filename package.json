    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "electron-updater": "6.8.9",
    "immer": "^11.1.21",
    "lucide-react": "^1.59.0",
